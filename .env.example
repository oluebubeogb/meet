# Server
PORT=1880
NODE_ENV=production

# SQLite data directory (persisted via Docker volume) — baseline until Phase 1
DATA_DIR=/app/data

# Phase 1: PostgreSQL (set after migration; then DATA_DIR is only for files if needed)
# DATABASE_URL=postgresql://user:password@postgres-host:5432/meet

# JWT for login sessions (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL=30d

# LiveKit (required for screenshare + audio)
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your-secret-here-min-32-chars-recommended

# Collab Accounts (central identity for the suite)
# When set, Meet login/signup proxies to Accounts and validates suite tokens.
ACCOUNTS_URL=https://accounts.collab.name.ng
# Optional: same SECRET_KEY as Accounts for local JWT verification (faster)
# ACCOUNTS_JWT_SECRET=
# ACCOUNTS_SECRET_KEY=
